.DS_Store

# Python cache / bytecode
__pycache__/
*.pyc
*.pyo

# Local-only content (do not push)
/private/
/archive_local/

# Generated outputs
/public/
/dist/
/backup_root/

# Local databases / runtime dumps
*.db
*.sqlite
*.sqlite3
*.parquet

# Secrets and credentials
.env
.env.*
*.key
*.pem
*secret*
*token*
*credential*

# Internal-only working data
/data/private/
/data/internal/
/backend/local_data/
/backend/tmp/
/backend/logs/

# Proposal warehouse private feeds should never be published
/nexus/projects/ai_opportunity_warehouse/data/raw/
/nexus/projects/ai_opportunity_warehouse/data/derived/
/nexus/projects/ai_opportunity_warehouse/data/outputs/
/nexus/projects/ai_opportunity_warehouse/data/warehouse/

# Build-time safety artifacts (should never be published)
/src/_root_conflicts/

# Local Python env
/.venv/
/.venv_build/

# Node / frontend workspace noise
/node_modules/
/web/node_modules/
/web/dist/
/web/.vite/
/web/.cache/

# Local deploy scratch (keep committed deploy output under /deploy)
/web/pages-only/

# Editor and temporary files
*.swp
*.swo
*.tmp

# OS metadata
Thumbs.db
