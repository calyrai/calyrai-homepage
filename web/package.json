{
  "name": "calyr-homepage",
  "version": "1.0.0",
  "description": "CALYR.aí semantic homepage renderer",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "sync:books": "cp ../../calyrai-ecosystem/build/books.page.json ./public/generated/books.page.json && echo '✅ books artifact synced'",
    "compile": "python3 ../build/compile.py pythia",
    "compile:watch": "nodemon --watch ../content --watch ../skins --ext yaml --exec 'python3 ../build/compile.py pythia'",
    "skin:pythia": "python3 ../build/compile.py pythia && echo '✅ Pythia theme locked - refresh browser'"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.2",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.0.0",
    "vite": "^5.2.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
