#!/usr/bin/env sh
set -eu

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$staged_files" ]; then
  exit 0
fi

blocked_paths_regex='(^|/)(node_modules|venv|\.venv|env|ENV|build|dist|coverage|\.cache|\.npm|\.pnpm-store|\.yarn|\.idea|\.vscode)(/|$)'
blocked_files_regex='\.(sqlite|sqlite3|db|parquet)$'

blocked=$(printf '%s\n' "$staged_files" | grep -E "$blocked_paths_regex|$blocked_files_regex" || true)

if [ -n "$blocked" ]; then
  echo "ERROR: Commit blocked. Forbidden staged paths/files detected:"
  printf '%s\n' "$blocked"
  echo
  echo "Policy: keep env/deps/build/cache/runtime data out of Git."
  exit 1
fi

max_bytes=$((20 * 1024 * 1024))
large_files=""

while IFS= read -r path; do
  [ -z "$path" ] && continue
  size=$(git cat-file -s ":$path" 2>/dev/null || echo 0)
  if [ "$size" -gt "$max_bytes" ]; then
    large_files="$large_files
$path ($size bytes)"
  fi
done <<EOF
$staged_files
EOF

if [ -n "$large_files" ]; then
  echo "ERROR: Commit blocked. Staged files exceed 20MB:"
  printf '%s\n' "$large_files"
  echo
  echo "Move large artifacts out of repo (use artifacts/ or data/ outside Git)."
  exit 1
fi

exit 0
