      "accent": "#ffffff",
      "accent_secondary": "#e0e0e0",
      "border": "rgba(255, 255, 255, 0.35)",
      "border_light": "rgba(255, 255, 255, 0.2)",
      "success": "#28a745",
      "warning": "#ffc107",
      "error": "#dc3545"
    },
    "components": {
      "ui": {
        "line_width": "1px"
      },
      "tile": {
        "background": "#000000",
        "background_hover": "rgba(255, 255, 255, 0.08)",
